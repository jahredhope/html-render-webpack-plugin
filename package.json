{
  "name": "html-render-webpack-plugin",
  "description": "webpack plugin for rendering static HTML in a multi-config webpack build",
  "author": "Jahred Hope <jahredhope@gmail.com>",
  "version": "3.0.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "html",
    "static",
    "plugin",
    "webpack"
  ],
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --declaration",
    "changeset": "changeset",
    "commit": "git-cz",
    "format": "prettier --write .",
    "lint": "pnpm run lint.eslint && pnpm run lint.prettier",
    "lint.eslint": "eslint . --ext .ts,.js",
    "lint.prettier": "prettier --check .",
    "prepack": "pnpm run build",
    "release": "changeset publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "version-packages": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jahredhope/html-render-webpack-plugin.git"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "webpack": "^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/debug": "^4.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^4.15.0",
    "@typescript-eslint/parser": "^4.15.0",
    "commitizen": "4.2.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "7.19.0",
    "express": "^5.3.0",
    "memfs": "^3.2.0",
    "prettier": "2.2.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "typescript": "^4.9.5",
    "vitest": "^5.0.5",
    "webpack": "^5.112.0",
    "webpack-merge": "^5.0.0"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "eval": "^0.1.8",
    "exception-formatter": "^2.1.2",
    "picocolors": "^1.1.1",
    "schema-utils": "^4.8.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}

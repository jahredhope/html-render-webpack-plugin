// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Watch > should render a HTML on initial watch build 1`] = `
{
  "a": {
    "index.html": "<html>
<body>
  Rendered with:&nbsp;
  common: {
  "value": "a"
}
  <code>[
    {
      "route": "/a/",
      "extra": "a"
    }
  ]</code>
</body>
</html>",
  },
  "b": {
    "index.html": "<html>
<body>
  Rendered with:&nbsp;
  common: {
  "value": "a"
}
  <code>[
    {
      "route": "/b/",
      "extra": "b"
    }
  ]</code>
</body>
</html>",
  },
}
`;
